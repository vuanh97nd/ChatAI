# Sao chép file này thành .env và điền giá trị thực.
# Không chia sẻ file .env vì chứa khóa bí mật.

# Khóa xác thực mà ứng dụng Chat AI sẽ gửi đến proxy này.
# Đặt chuỗi ngẫu nhiên dài ≥ 16 ký tự, ví dụ: openssl rand -hex 24
AUTH_KEY=

# Khóa API OpenAI (sk-...) để proxy gọi tới api.openai.com
OPENAI_API_KEY=

# Cổng proxy (mặc định 3040)
# PORT=3040

# URL gốc upstream (mặc định https://api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com
